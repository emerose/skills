# direnv config: load per-skill API keys from the macOS login Keychain into the
# environment, so secrets never live in this repo, in git, or in a plaintext file
# on disk. The skills read these from the real environment (they also fall back to
# ~/.env, but Keychain + direnv is preferred).
#
# One-time setup, per key (run these yourself so the value isn't logged):
#   security add-generic-password -s stable-api -a "$USER" -w '<key>'
# then trust this file once:
#   direnv allow
#
# After that, the keys are exported automatically whenever you cd into this repo.

# Stable (usestable.com) virtual-mailbox API key — used by skills/stable.
# Store with: security add-generic-password -s stable-api -a "$USER" -w '<key>'
export STABLE_API_KEY="$(security find-generic-password -s stable-api -a "$USER" -w 2>/dev/null)"

if [ -z "$STABLE_API_KEY" ]; then
  echo "warning: no 'stable-api' item found in Keychain — the stable skill will need STABLE_API_KEY set another way." >&2
fi
